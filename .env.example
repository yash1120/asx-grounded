# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
GENERATOR_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-opus-4-7

# --- Qdrant (vector store) ---
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=asx_chunks

# --- Postgres (metadata) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/asx_grounded

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# --- Retrieval ---
RETRIEVAL_TOP_K=50
RERANK_TOP_K=8
MIN_RELEVANCE_SCORE=0.30

# --- Ingestion ---
ASX_USER_AGENT=asx-grounded/0.1 (research; contact: yashgoyal1120@gmail.com)
ASX_RATE_LIMIT_PER_SEC=1.0
ASX_DATA_DIR=./data/raw

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
